#q1

const express = require('express');
const app = express();

app.use(express.json());

// Products array
let products = [];

// Create Product
app.post('/products', (req, res) => {
    products.push(req.body);
    res.send("Product Added Successfully");
});

// Read Products
app.get('/products', (req, res) => {
    res.json(products);
});

// Start Server
app.listen(3000, () => {
    console.log("Server running on port 3000");
});

