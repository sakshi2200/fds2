<!DOCTYPE html>
<html>
<head>
    <title>Games List</title>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
</head>

<body ng-app="" ng-init="games=['Cricket','Football','Hockey','Tennis','Badminton']">

    <h2>AngularJS Games List</h2>

    <p ng-bind="'Click the button to display games'"></p>

    <button ng-click="show=true">Show Games</button>

    <ul ng-show="show">
        <li ng-repeat="game in games">{{game}}</li>
    </ul>

</body>
</html>


