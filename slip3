<!DOCTYPE html>
<html>
<body>

<h2>Find Company</h2>
<p id="demo"></p>

<script>
let companies = [
    {id: 1, name: "Google", employees: 50},
    {id: 2, name: "Microsoft", employees: 25},
    {id: 3, name: "Amazon", employees: 40},
    {id: 4, name: "Infosys", employees: 20}
];

let result = companies.find(company => company.employees > 30);

document.getElementById("demo").innerHTML =
    "Company: " + result.name + "<br>Workforce: " + result.employees;
</script>

</body>
</html>
