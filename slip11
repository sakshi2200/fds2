import { Component } from '@angular/core';

@Component({
  selector: 'app-root',
  template: `
    <h2>Basketball Players</h2>
    <ul>
      <li *ngFor="let name of players">{{name}}</li>
    </ul>
  `
})
export class AppComponent {

  students = [
    {name: 'Sakshi', game: 'Basketball'},
    {name: 'Rahul', game: 'Cricket'},
    {name: 'Priya', game: 'Basketball'},
    {name: 'Amit', game: 'Football'}
  ];

  players = this.students
    .filter(s => s.game === 'Basketball')
    .map(s => s.name);
}
