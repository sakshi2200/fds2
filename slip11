const express = require('express');
const app = express();

app.use(express.json());

// Movies array
let movies = [];

// Create Movie
app.post('/movies', (req, res) => {
    movies.push(req.body);
    res.json({
        message: "Movie Added Successfully",
        data: req.body
    });
});

// Start Server
app.listen(3000, () => {
    console.log("Server running on port 3000");
});

